diff --git a/src/ScreenRecorder.Infrastructure/Audio/AudioAnalyzer.cs b/src/ScreenRecorder.Infrastructure/Audio/AudioAnalyzer.cs
new file mode 100644
index 0000000..d43b25d
--- /dev/null
+++ b/src/ScreenRecorder.Infrastructure/Audio/AudioAnalyzer.cs
@@ -0,0 +1,166 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using NAudio.Wave;
+using ScreenRecorder.Core.Models;
+using ScreenRecorder.Infrastructure.Encoding;
+
+namespace ScreenRecorder.Infrastructure.Audio;
+
+/// <summary>
+/// Простой анализатор WAV: ищет клиппинг, «цифровую тишину» посреди записи (потерянные пакеты)
+/// и резкие скачки сигнала (щелчки). Это эвристика: она хорошо подходит для сравнения двух записей
+/// одного и того же источника (например, ScreenRecorder и Bandicam), но не заменяет прослушивание.
+/// Пороги вынесены в константы.
+/// </summary>
+public static class AudioAnalyzer
+{
+    private const float ClickAbsoluteMin = 0.03f;   // минимальный скачок между соседними сэмплами
+    private const float ClickRelativeFactor = 12f;  // во сколько раз скачок выше локального среднего
+    private const double ClickRefractoryMs = 2.0;   // не считаем один щелчок несколько раз
+    private const double DropoutMinMs = 2.0;        // минимальная длина «цифровой тишины»
+
+    public static AudioAnalysis AnalyzeWav(string path, string? displayName = null)
+    {
+        using var reader = new WaveFileReader(path);
+        var fmt = reader.WaveFormat;
+        int ch = fmt.Channels;
+        int rate = fmt.SampleRate;
+        int frameBytes = fmt.BlockAlign;
+
+        const int framesPerRead = 8192;
+        var bytes = new byte[frameBytes * framesPerRead];
+        var dec = new float[framesPerRead * ch];
+
+        long total = 0, clipped = 0;
+        double sumSq = 0, sum = 0;
+        float peak = 0;
+
+        int winLen = Math.Max(1, rate / 50); // окно 20 мс
+        double winSq = 0; int winCnt = 0;
+        var windowsDb = new List<float>();
+
+        float prev = 0, ema = 0;
+        float alpha = 1f / Math.Max(1f, 0.005f * rate);
+        long lastClick = -1_000_000;
+        long refractory = (long)(ClickRefractoryMs * rate / 1000.0);
+        long warmup = rate / 50;
+        int clicks = 0;
+
+        long zeroRun = 0, minZeroRun = (long)(DropoutMinMs * rate / 1000.0);
+        bool seenSignal = false;
+        int dropouts = 0;
+
+        int n;
+        while ((n = reader.Read(bytes, 0, bytes.Length)) > 0)
+        {
+            int frames = n / frameBytes;
+            if (frames == 0) break;
+            AudioFormatHelper.Decode(bytes, frames * ch, fmt, dec);
+
+            for (int f = 0; f < frames; f++)
+            {
+                float x;
+                if (ch == 1) x = dec[f];
+                else
+                {
+                    float s = 0;
+                    for (int c = 0; c < ch; c++) s += dec[f * ch + c];
+                    x = s / ch;
+                }
+
+                float a = Math.Abs(x);
+                if (a > peak) peak = a;
+                if (a >= 0.999f) clipped++;
+                sumSq += (double)x * x;
+                sum += x;
+
+                winSq += (double)x * x;
+                if (++winCnt >= winLen)
+                {
+                    windowsDb.Add((float)(10.0 * Math.Log10(Math.Max(winSq / winCnt, 1e-12))));
+                    winSq = 0; winCnt = 0;
+                }
+
+                // Цифровая тишина посреди записи (не в начале и не в конце).
+                if (a < 1e-9f) zeroRun++;
+                else
+                {
+                    if (seenSignal && zeroRun >= minZeroRun) dropouts++;
+                    zeroRun = 0;
+                    seenSignal = true;
+                }
+
+                // Щелчки: скачок между соседними сэмплами сильно выше среднего скачка за последние ~5 мс.
+                float d = Math.Abs(x - prev);
+                if (total > warmup && d > Math.Max(ClickAbsoluteMin, ClickRelativeFactor * ema)
+                    && total - lastClick > refractory)
+                {
+                    clicks++;
+                    lastClick = total;
+                }
+                ema += alpha * (d - ema);
+                prev = x;
+                total++;
+            }
+        }
+
+        double duration = rate > 0 ? total / (double)rate : 0;
+        double rms = total > 0 ? Math.Sqrt(sumSq / total) : 0;
+        double dc = total > 0 ? sum / total : 0;
+        double noiseFloor = -120;
+        if (windowsDb.Count > 0)
+        {
+            windowsDb.Sort();
+            noiseFloor = windowsDb[(int)(windowsDb.Count * 0.10)];
+        }
+        double perMin = duration > 1 ? clicks / (duration / 60.0) : 0;
+
+        string verdict;
+        if (total == 0) verdict = "File is empty.";
+        else if (dropouts > 0 || perMin > 15)
+            verdict = "Likely audible defects (dropouts or crackle). Compare with a known-good recording of the same source.";
+        else if (perMin > 3)
+            verdict = "Some suspicious clicks. Compare with a known-good recording of the same source.";
+        else
+            verdict = "No obvious defects detected by this heuristic.";
+        if (total > 0 && clipped > total * 0.0001) verdict += " Signal clips: lower the input gain.";
+
+        return new AudioAnalysis(displayName ?? Path.GetFileName(path), duration, rate,
+            peak > 1e-6f ? 20.0 * Math.Log10(peak) : -120, rms > 1e-6 ? 20.0 * Math.Log10(rms) : -120,
+            noiseFloor, clipped, dc, dropouts, clicks, perMin, verdict);
+    }
+
+    /// <summary>Анализирует WAV напрямую, остальные форматы (mp4, m4a, mp3, flac…) сначала конвертирует через ffmpeg.</summary>
+    public static async Task<AudioAnalysis> AnalyzeAnyAsync(string path)
+    {
+        if (string.Equals(Path.GetExtension(path), ".wav", StringComparison.OrdinalIgnoreCase))
+        {
+            return await Task.Run(() => AnalyzeWav(path));
+        }
+
+        string tmp = Path.Combine(Path.GetTempPath(), "sr_analyze_" + Guid.NewGuid().ToString("N") + ".wav");
+        try
+        {
+            var (code, err) = await FfmpegRunner.RunAsync(new[]
+            {
+                "-y", "-i", path, "-vn", "-ac", "1", "-ar", "48000", "-c:a", "pcm_s16le", tmp
+            });
+            if (code != 0 || !File.Exists(tmp))
+                throw new InvalidOperationException("ffmpeg could not read the audio: " + Tail(err));
+            return await Task.Run(() => AnalyzeWav(tmp, Path.GetFileName(path)));
+        }
+        finally
+        {
+            try { if (File.Exists(tmp)) File.Delete(tmp); } catch { }
+        }
+    }
+
+    private static string Tail(string s)
+    {
+        var lines = s.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
+        return string.Join(" | ", lines.TakeLast(2));
+    }
+}
diff --git a/src/ScreenRecorder.Infrastructure/Audio/AudioDeviceService.cs b/src/ScreenRecorder.Infrastructure/Audio/AudioDeviceService.cs
new file mode 100644
index 0000000..0500e19
--- /dev/null
+++ b/src/ScreenRecorder.Infrastructure/Audio/AudioDeviceService.cs
@@ -0,0 +1,88 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Threading.Tasks;
+using NAudio.CoreAudioApi;
+using NAudio.Wave;
+using ScreenRecorder.Core.Interfaces;
+using ScreenRecorder.Core.Models;
+
+namespace ScreenRecorder.Infrastructure.Audio;
+
+public sealed class AudioDeviceService : IAudioDeviceService
+{
+    public IReadOnlyList<AudioDevice> GetDevices()
+    {
+        var list = new List<AudioDevice>();
+        try
+        {
+            using var en = new MMDeviceEnumerator();
+            foreach (var d in en.EnumerateAudioEndPoints(DataFlow.Capture, DeviceState.Active))
+                list.Add(new AudioDevice(d.ID, d.FriendlyName, true));
+            foreach (var d in en.EnumerateAudioEndPoints(DataFlow.Render, DeviceState.Active))
+                list.Add(new AudioDevice(d.ID, d.FriendlyName, false));
+        }
+        catch { /* нет устройств или сервис звука недоступен */ }
+        return list;
+    }
+
+    public string DescribeMixFormat(string deviceId)
+    {
+        try
+        {
+            using var en = new MMDeviceEnumerator();
+            var dev = en.GetDevice(deviceId);
+            return AudioFormatHelper.Describe(dev.AudioClient.MixFormat) + " (shared-mode mix format)";
+        }
+        catch (Exception ex)
+        {
+            return "unavailable: " + ex.Message;
+        }
+    }
+
+    public Task<string> ProbeFormatsAsync(string deviceId) => Task.Run(() =>
+    {
+        var sb = new StringBuilder();
+        try
+        {
+            using var en = new MMDeviceEnumerator();
+            var dev = en.GetDevice(deviceId);
+            var ac = dev.AudioClient;
+            sb.AppendLine($"Device: {dev.FriendlyName} ({(dev.DataFlow == DataFlow.Capture ? "input" : "output, loopback")})");
+            sb.AppendLine($"Mix format: {AudioFormatHelper.Describe(ac.MixFormat)}");
+
+            foreach (var mode in new[] { AudioClientShareMode.Shared, AudioClientShareMode.Exclusive })
+            {
+                sb.AppendLine();
+                sb.AppendLine($"{mode} mode, formats accepted by the driver:");
+                bool any = false;
+                foreach (int rate in AudioCaptureSettings.AllowedDriverRates)
+                {
+                    var ok = new List<string>();
+                    foreach (int ch in new[] { 1, 2 })
+                    {
+                        if (Supported(ac, mode, new WaveFormat(rate, 16, ch))) ok.Add($"16-bit/{ch}ch");
+                        if (Supported(ac, mode, new WaveFormat(rate, 24, ch))) ok.Add($"24-bit/{ch}ch");
+                        if (Supported(ac, mode, WaveFormat.CreateIeeeFloatWaveFormat(rate, ch))) ok.Add($"float/{ch}ch");
+                    }
+                    if (ok.Count > 0) { any = true; sb.AppendLine($"  {rate} Hz: {string.Join(", ", ok)}"); }
+                }
+                if (!any) sb.AppendLine("  none of the tested formats");
+            }
+            sb.AppendLine();
+            sb.AppendLine("Note: in shared mode Windows can convert formats itself, so the list may be short while a custom format still works.");
+        }
+        catch (Exception ex)
+        {
+            sb.AppendLine("Probe failed: " + ex.Message);
+        }
+        return sb.ToString();
+    });
+
+    private static bool Supported(AudioClient ac, AudioClientShareMode mode, WaveFormat fmt)
+    {
+        try { return ac.IsFormatSupported(mode, fmt); }
+        catch { return false; }
+    }
+}
diff --git a/src/ScreenRecorder.Infrastructure/Audio/AudioFormatHelper.cs b/src/ScreenRecorder.Infrastructure/Audio/AudioFormatHelper.cs
new file mode 100644
index 0000000..e064efd
--- /dev/null
+++ b/src/ScreenRecorder.Infrastructure/Audio/AudioFormatHelper.cs
@@ -0,0 +1,62 @@
+using System;
+using NAudio.Wave;
+
+namespace ScreenRecorder.Infrastructure.Audio;
+
+/// <summary>Вспомогательные функции для работы с форматами и декодирования PCM/float в float[].</summary>
+public static class AudioFormatHelper
+{
+    private static readonly Guid SubtypeIeeeFloat = new("00000003-0000-0010-8000-00aa00389b71");
+
+    public static bool IsFloat(WaveFormat f) =>
+        f.Encoding == WaveFormatEncoding.IeeeFloat ||
+        (f is WaveFormatExtensible ext && ext.SubFormat == SubtypeIeeeFloat);
+
+    /// <summary>Заголовок WAV без WAVE_FORMAT_EXTENSIBLE (его понимают все плееры и NAudio-ридеры).</summary>
+    public static WaveFormat ToStandard(WaveFormat f) =>
+        IsFloat(f)
+            ? WaveFormat.CreateIeeeFloatWaveFormat(f.SampleRate, f.Channels)
+            : new WaveFormat(f.SampleRate, f.BitsPerSample, f.Channels);
+
+    public static string Describe(WaveFormat f) =>
+        $"{f.SampleRate} Hz, {f.BitsPerSample}-bit {(IsFloat(f) ? "float" : "PCM")}, {f.Channels} ch";
+
+    /// <summary>
+    /// Преобразует байты в float [-1..1]. Выходной массив должен вмещать count сэмплов
+    /// (count = число сэмплов всех каналов).
+    /// </summary>
+    public static void Decode(byte[] src, int sampleCount, WaveFormat f, float[] dst)
+    {
+        bool isFloat = IsFloat(f);
+        int bits = f.BitsPerSample;
+        if (isFloat)
+        {
+            if (bits == 32) { for (int i = 0; i < sampleCount; i++) dst[i] = BitConverter.ToSingle(src, i * 4); }
+            else if (bits == 64) { for (int i = 0; i < sampleCount; i++) dst[i] = (float)BitConverter.ToDouble(src, i * 8); }
+            else throw new NotSupportedException($"Unsupported float bit depth: {bits}");
+            return;
+        }
+        switch (bits)
+        {
+            case 8:
+                for (int i = 0; i < sampleCount; i++) dst[i] = (src[i] - 128) / 128f;
+                break;
+            case 16:
+                for (int i = 0; i < sampleCount; i++) dst[i] = BitConverter.ToInt16(src, i * 2) / 32768f;
+                break;
+            case 24:
+                for (int i = 0; i < sampleCount; i++)
+                {
+                    int o = i * 3;
+                    int v = src[o] | (src[o + 1] << 8) | ((sbyte)src[o + 2] << 16);
+                    dst[i] = v / 8388608f;
+                }
+                break;
+            case 32:
+                for (int i = 0; i < sampleCount; i++) dst[i] = BitConverter.ToInt32(src, i * 4) / 2147483648f;
+                break;
+            default:
+                throw new NotSupportedException($"Unsupported PCM bit depth: {bits}");
+        }
+    }
+}
diff --git a/src/ScreenRecorder.Infrastructure/Audio/AudioProcessingChain.cs b/src/ScreenRecorder.Infrastructure/Audio/AudioProcessingChain.cs
new file mode 100644
index 0000000..6890167
--- /dev/null
+++ b/src/ScreenRecorder.Infrastructure/Audio/AudioProcessingChain.cs
@@ -0,0 +1,244 @@
+using System;
+using System.Collections.Generic;
+using NAudio.Dsp;
+using NAudio.Wave;
+using ScreenRecorder.Core.Models;
+
+namespace ScreenRecorder.Infrastructure.Audio;
+
+/// <summary>
+/// Цепочка обработки: байты устройства → float → выбор каналов → усиление → фильтр НЧ → эквалайзер →
+/// ресемплинг → квантование (16/24 бит PCM или 32 бит float) → приёмник. Не зависит от WASAPI,
+/// поэтому используется и при записи, и при повторной обработке готового raw-файла.
+/// Класс не потокобезопасен: вызывать из одного потока.
+/// </summary>
+public sealed class AudioProcessingChain
+{
+    private readonly WaveFormat _src;
+    private readonly AudioCaptureSettings _s;
+    private readonly int _srcCh, _outCh, _srcRate, _outRate, _blockAlign;
+    private readonly float _gain;
+    private readonly BiQuadFilter[][] _filters;
+    private readonly StreamingResampler? _resampler;
+    private readonly float[] _resBuf;
+
+    private float[] _decoded = Array.Empty<float>();
+    private float[] _mapped = Array.Empty<float>();
+    private byte[] _outBytes = Array.Empty<byte>();
+
+    private float _peak;
+    private double _sumSq;
+    private long _levelCount;
+    private int _clipped;
+
+    /// <summary>Формат, в котором эта цепочка отдаёт данные (стандартный WAV-заголовок).</summary>
+    public WaveFormat OutputFormat { get; }
+
+    public AudioProcessingChain(WaveFormat source, AudioCaptureSettings settings)
+    {
+        _src = source;
+        _s = settings;
+        _srcCh = source.Channels;
+        _srcRate = source.SampleRate;
+        _blockAlign = source.BlockAlign;
+
+        _outCh = settings.ChannelMode switch
+        {
+            AudioChannelMode.Mono or AudioChannelMode.LeftOnly or AudioChannelMode.RightOnly => 1,
+            AudioChannelMode.Stereo => 2,
+            _ => _srcCh == 1 ? 1 : 2
+        };
+        _outRate = settings.OutputSampleRate > 0 ? settings.OutputSampleRate : _srcRate;
+
+        OutputFormat = settings.OutputBitDepth switch
+        {
+            AudioBitDepth.Pcm16 => new WaveFormat(_outRate, 16, _outCh),
+            AudioBitDepth.Pcm24 => new WaveFormat(_outRate, 24, _outCh),
+            _ => WaveFormat.CreateIeeeFloatWaveFormat(_outRate, _outCh)
+        };
+
+        _gain = (float)Math.Pow(10.0, settings.InputGainDb / 20.0);
+
+        // Фильтры считаются на частоте источника: полосы выше 0.45*Fs не применяем (иначе нестабильны).
+        _filters = new BiQuadFilter[_outCh][];
+        for (int c = 0; c < _outCh; c++)
+        {
+            var list = new List<BiQuadFilter>();
+            if (settings.HighPassHz > 0 && settings.HighPassHz < _srcRate * 0.45f)
+                list.Add(BiQuadFilter.HighPassFilter(_srcRate, settings.HighPassHz, 0.7071f));
+            if (settings.Equalizer.Enabled)
+            {
+                for (int b = 0; b < EqualizerPresets.BandCount; b++)
+                {
+                    float gainDb = settings.Equalizer.BandGainsDb[b];
+                    float f = EqualizerPresets.BandFrequencies[b];
+                    if (Math.Abs(gainDb) >= 0.1f && f < _srcRate * 0.45f)
+                        list.Add(BiQuadFilter.PeakingEQ(_srcRate, f, 1.0f, gainDb));
+                }
+            }
+            _filters[c] = list.ToArray();
+        }
+
+        if (_outRate != _srcRate)
+            _resampler = new StreamingResampler(_srcRate, _outRate, _outCh);
+
+        _resBuf = new float[_outCh * 2048];
+        ValidateSource();
+    }
+
+    private void ValidateSource()
+    {
+        // Бросаем исключение заранее, а не посреди записи.
+        var probe = new byte[_blockAlign];
+        var dst = new float[_srcCh];
+        AudioFormatHelper.Decode(probe, _srcCh, _src, dst);
+    }
+
+    /// <summary>Обрабатывает порцию данных устройства и передаёт готовые байты приёмнику.</summary>
+    public void Process(byte[] src, int length, Action<byte[], int> sink)
+    {
+        int frames = length / _blockAlign;
+        if (frames <= 0) return;
+
+        int srcSamples = frames * _srcCh;
+        int outSamples = frames * _outCh;
+        Ensure(ref _decoded, srcSamples);
+        Ensure(ref _mapped, outSamples);
+
+        AudioFormatHelper.Decode(src, srcSamples, _src, _decoded);
+        MapChannels(frames);
+
+        for (int c = 0; c < _outCh; c++)
+        {
+            var chain = _filters[c];
+            for (int i = c; i < outSamples; i += _outCh)
+            {
+                float x = _mapped[i] * _gain;
+                for (int k = 0; k < chain.Length; k++) x = chain[k].Transform(x);
+                _mapped[i] = x;
+            }
+        }
+
+        if (_resampler == null)
+        {
+            Emit(_mapped, outSamples, sink);
+        }
+        else
+        {
+            _resampler.Push(_mapped, outSamples);
+            for (int guard = 0; guard < 4096; guard++)
+            {
+                int n = _resampler.Pull(_resBuf);
+                if (n <= 0) break;
+                Emit(_resBuf, n, sink);
+            }
+        }
+    }
+
+    /// <summary>Возвращает пик/RMS с прошлого вызова и сбрасывает счётчики.</summary>
+    public AudioLevel TakeLevel()
+    {
+        float peakDb = _peak > 1e-6f ? 20f * MathF.Log10(_peak) : -120f;
+        float rms = _levelCount > 0 ? (float)Math.Sqrt(_sumSq / _levelCount) : 0f;
+        float rmsDb = rms > 1e-6f ? 20f * MathF.Log10(rms) : -120f;
+        var level = new AudioLevel(peakDb, rmsDb, _clipped);
+        _peak = 0; _sumSq = 0; _levelCount = 0; _clipped = 0;
+        return level;
+    }
+
+    private void MapChannels(int frames)
+    {
+        int sc = _srcCh, oc = _outCh;
+        var d = _decoded;
+        var m = _mapped;
+        var mode = _s.ChannelMode;
+        for (int f = 0; f < frames; f++)
+        {
+            int si = f * sc, oi = f * oc;
+            switch (mode)
+            {
+                case AudioChannelMode.Mono:
+                {
+                    float sum = 0;
+                    for (int c = 0; c < sc; c++) sum += d[si + c];
+                    m[oi] = sum / sc;
+                    break;
+                }
+                case AudioChannelMode.LeftOnly:
+                    m[oi] = d[si];
+                    break;
+                case AudioChannelMode.RightOnly:
+                    m[oi] = d[si + (sc > 1 ? 1 : 0)];
+                    break;
+                default: // Auto, Stereo
+                    if (oc == 1) m[oi] = d[si];
+                    else { m[oi] = d[si]; m[oi + 1] = sc > 1 ? d[si + 1] : d[si]; }
+                    break;
+            }
+        }
+    }
+
+    private void Emit(float[] data, int count, Action<byte[], int> sink)
+    {
+        for (int i = 0; i < count; i++)
+        {
+            float x = data[i];
+            float a = Math.Abs(x);
+            if (a >= 1f) { _clipped++; x = x > 0 ? 1f : -1f; a = 1f; data[i] = x; }
+            if (a > _peak) _peak = a;
+            _sumSq += (double)x * x;
+        }
+        _levelCount += count;
+
+        switch (_s.OutputBitDepth)
+        {
+            case AudioBitDepth.Pcm16:
+            {
+                int bytes = count * 2;
+                Ensure(ref _outBytes, bytes);
+                int o = 0;
+                var rnd = Random.Shared;
+                for (int i = 0; i < count; i++)
+                {
+                    float v = data[i] * 32767f;
+                    if (_s.Dither) v += (float)(rnd.NextDouble() - rnd.NextDouble()); // TPDF, ±1 LSB
+                    int q = (int)MathF.Round(v);
+                    if (q > 32767) q = 32767; else if (q < -32768) q = -32768;
+                    _outBytes[o++] = (byte)q;
+                    _outBytes[o++] = (byte)(q >> 8);
+                }
+                sink(_outBytes, bytes);
+                break;
+            }
+            case AudioBitDepth.Pcm24:
+            {
+                int bytes = count * 3;
+                Ensure(ref _outBytes, bytes);
+                int o = 0;
+                for (int i = 0; i < count; i++)
+                {
+                    int q = (int)MathF.Round(data[i] * 8388607f);
+                    if (q > 8388607) q = 8388607; else if (q < -8388608) q = -8388608;
+                    _outBytes[o++] = (byte)q;
+                    _outBytes[o++] = (byte)(q >> 8);
+                    _outBytes[o++] = (byte)(q >> 16);
+                }
+                sink(_outBytes, bytes);
+                break;
+            }
+            default:
+            {
+                int bytes = count * 4;
+                Ensure(ref _outBytes, bytes);
+                Buffer.BlockCopy(data, 0, _outBytes, 0, bytes);
+                sink(_outBytes, bytes);
+                break;
+            }
+        }
+    }
+
+    private static void Ensure<T>(ref T[] arr, int size)
+    {
+        if (arr.Length < size) arr = new T[Math.Max(size, arr.Length * 2)];
+    }
+}
diff --git a/src/ScreenRecorder.Infrastructure/Audio/AudioTestService.cs b/src/ScreenRecorder.Infrastructure/Audio/AudioTestService.cs
new file mode 100644
index 0000000..1fdb414
--- /dev/null
+++ b/src/ScreenRecorder.Infrastructure/Audio/AudioTestService.cs
@@ -0,0 +1,153 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using NAudio.Wave;
+using ScreenRecorder.Core.Enums;
+using ScreenRecorder.Core.Interfaces;
+using ScreenRecorder.Core.Models;
+using ScreenRecorder.Infrastructure.Encoding;
+
+namespace ScreenRecorder.Infrastructure.Audio;
+
+/// <summary>
+/// Запись только звука (без видео и без ffmpeg-видеоконвейера) для проверки чистоты захвата.
+/// Использует собственный экземпляр WasapiAudioCapture, поэтому не мешает основной записи,
+/// но запускается только когда основная запись не идёт.
+/// </summary>
+public sealed class AudioTestService : IAudioTestService
+{
+    private readonly ILoggerService _logger;
+    private readonly IRecordingSession _session;
+
+    private WasapiAudioCapture? _capture;
+    private AudioTestOptions? _options;
+    private string? _processedPath, _rawPath;
+
+    public AudioTestService(ILoggerService logger, IRecordingSession session)
+    {
+        _logger = logger;
+        _session = session;
+    }
+
+    public bool IsRunning => _capture?.IsRunning == true;
+    public event Action<AudioLevel>? Level;
+    public AudioCaptureStats? GetLiveStats() => _capture?.GetStats();
+
+    public async Task<string?> StartAsync(AudioTestOptions o)
+    {
+        if (IsRunning) return "A test is already running.";
+        if (_session.State != RecordingState.Idle) return "Stop the screen recording before running an audio test.";
+        if (string.IsNullOrWhiteSpace(o.DeviceId)) return "Select an audio device first.";
+
+        try { Directory.CreateDirectory(o.OutputFolder); }
+        catch (Exception ex) { return $"Cannot use test folder: {ex.Message}"; }
+
+        string stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
+        _processedPath = Path.Combine(o.OutputFolder, $"audiotest_{stamp}.wav");
+        _rawPath = o.SaveRawCopy ? Path.Combine(o.OutputFolder, $"audiotest_{stamp}_raw.wav") : null;
+        _options = o;
+
+        var cap = new WasapiAudioCapture(_logger);
+        cap.LevelMeasured += l => Level?.Invoke(l);
+        _capture = cap;
+
+        await cap.StartAsync(new AudioCaptureRequest(o.DeviceId, _processedPath, o.Settings, _rawPath), CancellationToken.None);
+        if (!cap.IsRunning)
+        {
+            _capture = null;
+            return cap.LastError ?? "Audio capture failed to start (see log).";
+        }
+        _logger.Log($"Audio test started: {_processedPath}");
+        return null;
+    }
+
+    public async Task<AudioTestResult> StopAsync()
+    {
+        var cap = _capture;
+        var o = _options;
+        if (cap == null || o == null)
+            return new AudioTestResult(null, null, null, null, null, null, "No test is running.");
+
+        await cap.StopAsync();
+        _capture = null;
+        _logger.Log("Audio test stopped.");
+        return await FinishAsync(_processedPath, _rawPath, cap.LastReport, o.Container, o.Settings.AacBitrateKbps, cap.LastError);
+    }
+
+    public async Task<AudioTestResult> ReprocessAsync(string rawWavPath, AudioCaptureSettings settings, AudioTestContainer container)
+    {
+        var s = settings.Clone();
+        s.Normalize();
+        string dir = Path.GetDirectoryName(Path.GetFullPath(rawWavPath))!;
+        string baseName = Path.GetFileNameWithoutExtension(rawWavPath);
+        if (baseName.EndsWith("_raw", StringComparison.OrdinalIgnoreCase)) baseName = baseName[..^4];
+        string outPath = Path.Combine(dir, $"{baseName}_reprocessed_{DateTime.Now:HHmmss}.wav");
+
+        try
+        {
+            await Task.Run(() =>
+            {
+                using var reader = new WaveFileReader(rawWavPath);
+                var chain = new AudioProcessingChain(reader.WaveFormat, s);
+                using var writer = new WaveFileWriter(outPath, chain.OutputFormat);
+                var buf = new byte[reader.WaveFormat.BlockAlign * 4800];
+                int n;
+                while ((n = reader.Read(buf, 0, buf.Length)) > 0)
+                    chain.Process(buf, n, (b, c) => writer.Write(b, 0, c));
+            });
+            _logger.Log($"Audio test: reprocessed '{Path.GetFileName(rawWavPath)}' with [{s.Describe()}]");
+        }
+        catch (Exception ex)
+        {
+            _logger.Log($"Audio reprocess failed: {ex.Message}");
+            return new AudioTestResult(null, rawWavPath, null, null, null, null, $"Reprocess failed: {ex.Message}");
+        }
+        return await FinishAsync(outPath, null, null, container, s.AacBitrateKbps, null);
+    }
+
+    public Task<AudioAnalysis> AnalyzeFileAsync(string path) => AudioAnalyzer.AnalyzeAnyAsync(path);
+
+    private async Task<AudioTestResult> FinishAsync(string? processed, string? raw, AudioCaptureReport? report,
+        AudioTestContainer container, int aacKbps, string? error)
+    {
+        AudioAnalysis? pa = null, ra = null;
+        string? converted = null;
+
+        try { if (processed != null && File.Exists(processed)) pa = await Task.Run(() => AudioAnalyzer.AnalyzeWav(processed)); }
+        catch (Exception ex) { error ??= "Analysis failed: " + ex.Message; }
+        try { if (raw != null && File.Exists(raw)) ra = await Task.Run(() => AudioAnalyzer.AnalyzeWav(raw)); }
+        catch (Exception ex) { error ??= "Raw analysis failed: " + ex.Message; }
+
+        if (container != AudioTestContainer.Wav && processed != null && File.Exists(processed))
+        {
+            try { converted = await ConvertAsync(processed, container, aacKbps); }
+            catch (Exception ex) { error = (error == null ? "" : error + " ") + "Conversion failed: " + ex.Message; }
+        }
+
+        return new AudioTestResult(processed, raw, converted, report, pa, ra, error);
+    }
+
+    private static async Task<string> ConvertAsync(string wavPath, AudioTestContainer container, int aacKbps)
+    {
+        string ext = container switch { AudioTestContainer.Flac => ".flac", AudioTestContainer.Mp3 => ".mp3", _ => ".m4a" };
+        string outPath = Path.ChangeExtension(wavPath, ext);
+        var args = new System.Collections.Generic.List<string> { "-y", "-i", wavPath, "-vn" };
+        switch (container)
+        {
