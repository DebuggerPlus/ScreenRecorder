<Window x:Class="ScreenRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ScreenRecorder.Core.Enums;assembly=ScreenRecorder.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Screen Recorder Pro" Height="500" Width="800" Background="#F0F0F0">
    <Window.Resources>
        <ObjectDataProvider x:Key="CaptureModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:CaptureMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <StackPanel Margin="20">
            <DockPanel LastChildFill="False" Margin="0,0,0,20">
                <TextBlock Text="SCREEN RECORDER" FontSize="28" FontWeight="Bold" Foreground="Black"/>
                <Button Content="Set Output Folder" Command="{Binding OpenSettingsCommand}" DockPanel.Dock="Right" Padding="10,5"/>
            </DockPanel>
            
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="15">
                <StackPanel>
                    <TextBlock Text="Capture Mode:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource CaptureModes}}" 
                              SelectedItem="{Binding SelectedCaptureMode}" 
                              Height="30" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Capture Source:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableSources}" 
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="Name"
                              Height="30" Margin="0,0,0,10"/>
                    <Button Content="Refresh Sources" Command="{Binding RefreshSourcesCommand}" Height="30"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30">
                <Button Content="REC" Command="{Binding StartRecordingCommand}" 
                        Width="100" Height="50" Background="DarkRed" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="STOP" Command="{Binding StopRecordingCommand}" 
                        Width="100" Height="50" Background="Black" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="PLAY LAST" Command="{Binding PlayLastRecordingCommand}" 
                        Width="100" Height="50" Background="Gray" Foreground="White" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="{Binding TimerDisplay}" FontSize="48" HorizontalAlignment="Center" Foreground="DarkBlue"/>
            <TextBlock Text="{Binding State}" FontSize="14" HorizontalAlignment="Center" Foreground="Gray" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>