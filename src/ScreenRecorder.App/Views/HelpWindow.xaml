<Window x:Class="ScreenRecorder.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка по настройке звука" Height="500" Width="650" 
        WindowStartupLocation="CenterOwner" Background="#F9F9F8">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Как убрать потрескивание и улучшить звук" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                
                <Border Background="#EBEDEF" Padding="15" CornerRadius="5" Margin="0,0,0,20">
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                        Потрескивание обычно возникает из-за микро-задержек при передаче данных от телефона (iVCam) по Wi-Fi или из-за высокой нагрузки на процессор. Ниже приведены шаги для решения проблемы.
                    </TextBlock>
                </Border>

                <TextBlock Text="1. Настройка аудио (Audio Settings)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Margin="10,0,0,15">
                    <TextBlock Text="• Режим WASAPI:" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">Переключите с 'Event' на 'Polling'. Режим Polling часто работает стабильнее с виртуальными и сетевыми драйверами (iVCam).</TextBlock>
                    
                    <TextBlock Text="• Размер буфера (Buffer size):" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">Увеличьте ползунок до 200–300 мс. Это сгладит сетевые задержки Wi-Fi.</TextBlock>
                    
                    <TextBlock Text="• Формат (Output Format):" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap">Установите частоту, совпадающую с частотой микрофона (обычно 16000 Hz или 44100 Hz). Это снизит нагрузку на ресемплер.</TextBlock>
                </StackPanel>

                <TextBlock Text="2. Снижение нагрузки (за счет видео)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Margin="10,0,0,15">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">Если процессор занят кодированием видео, звук может "заикаться":</TextBlock>
                    <TextBlock Text="• Снизьте FPS:" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">Установите 20 или 24 кадра в секунду вместо 30.</TextBlock>
                    
                    <TextBlock Text="• Область записи:" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap">Запись всего экрана требует больше ресурсов, чем запись отдельного окна или региона.</TextBlock>
                </StackPanel>

                <TextBlock Text="3. Диагностика (Вкладка Test)" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Margin="10,0,0,10">Используйте кнопку 'Record test (audio only)'. Если звук в тесте (без видео) чистый, значит проблема в перегрузке процессора при захвате экрана.</TextBlock>

                <Button Content="Понятно" Click="CloseClick" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="5"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
