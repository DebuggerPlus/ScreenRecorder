<Window x:Class="ScreenRecorder.App.Views.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Saved Recordings" Height="540" Width="640" Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Папка для записей по умолчанию -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Default save folder" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" Background="#FAFAFA"
                         Padding="4,3" ToolTip="{Binding OutputFolder}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Change..." Command="{Binding ChooseOutputFolderCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Open folder" Command="{Binding OpenOutputFolderCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Reset to default" Command="{Binding ResetOutputFolderCommand}" Padding="12,4"/>
                </StackPanel>
                <TextBlock Text="New recordings are saved here. Audio test files go to the AudioTests subfolder."
                           Foreground="#666" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="1" Content="Refresh List" Command="{Binding RefreshFilesCommand}" HorizontalAlignment="Right" Padding="10,5" Margin="0,0,0,10"/>
        
        <ListBox Grid.Row="2" ItemsSource="{Binding SavedFiles}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CreatedAt}" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding Size}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Content="RENAME" Command="{Binding DataContext.RenameFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Margin="5,0" Padding="10,2" Background="LightGray"/>
                            <Button Grid.Column="2" Content="PLAY" Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Margin="5,0" Padding="10,2" Background="LightBlue"/>
                            <Button Grid.Column="3" Content="DELETE" Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}" Padding="10,2" Background="LightCoral"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>