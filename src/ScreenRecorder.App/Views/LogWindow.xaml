<Window x:Class="ScreenRecorder.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Logs" Height="300" Width="500" Background="#1E1E1E">
    <ListBox ItemsSource="{Binding LogEntries}" Background="Transparent" Foreground="LightGray" FontFamily="Consolas">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Window>