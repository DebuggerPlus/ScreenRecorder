<Window x:Class="ScreenRecorder.App.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Region" Height="300" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Grid>
        <!-- Внешняя рамка (только края ловят мышь для изменения размера/перемещения) -->
        <Border BorderBrush="Red" BorderThickness="4" Background="#01FFFFFF" MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <!-- Текст индикатор -->
                <TextBlock Text="Drag edges to resize / Drag border to move" 
                           Foreground="Red" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5"/>
            </Grid>
        </Border>
        
        <!-- Пустота внутри (не блокирует клики) -->
        <Border Margin="4" Background="Transparent" IsHitTestVisible="False"/>
        
        <!-- Маленький "зацеп" для изменения размера в углу -->
        <Thumb Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Thumb_DragDelta"/>
    </Grid>
</Window>