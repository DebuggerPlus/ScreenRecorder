<Window x:Class="ScreenRecorder.App.Views.VideoProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Video (noise reduction)" Height="840" Width="920" MinHeight="620" MinWidth="780"
        Background="#F0F0F0" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <Style x:Key="SliderRow" TargetType="Slider">
            <Setter Property="Width" Value="300"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- ===================== Файлы ===================== -->
            <TabItem Header="File">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <GroupBox Header="Input file">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseInputCommand}"
                                            Margin="8,0,0,0" Padding="12,4"/>
                                    <Button Grid.Column="2" Content="Latest recording" Command="{Binding UseLatestRecordingCommand}"
                                            Margin="8,0,0,0" Padding="12,4"
                                            ToolTip="Take the newest MP4/MKV from the recordings folder."/>
                                </Grid>
                                <TextBlock Text="{Binding InputInfoText}" Style="{StaticResource Hint}"/>
                                <Button Content="Re-read file info" Command="{Binding RefreshProbeCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource ActionButton}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Output file">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOutputCommand}"
                                            Margin="8,0,0,0" Padding="12,4"/>
                                </Grid>

                                <TextBlock Text="Container" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ContainerOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding Container}" Width="140" Height="28"
                                          HorizontalAlignment="Left"/>

                                <TextBlock Text="AAC bitrate of the result" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding BitrateOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding AacBitrateKbps}" Width="140" Height="28"
                                          HorizontalAlignment="Left"/>

                                <CheckBox Content="Copy the video stream as is (fast, no quality loss)" Margin="0,12,0,0"
                                          IsChecked="{Binding CopyVideoStream}"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Only the audio is re-encoded, the picture is copied bit by bit. Uncheck to re-encode the picture (for example to cut a segment)."/>

                                <StackPanel Visibility="{Binding ShowReencodeOptions, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Quality (CRF, lower = better)" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="14" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Crf}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Crf, StringFormat={}CRF {0}}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="x264 preset" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding VideoPresetNames}" SelectedItem="{Binding VideoPreset}"
                                              Width="140" Height="28" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Шумоподавление ===================== -->
            <TabItem Header="Noise reduction">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <GroupBox Header="Quick recipes">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Recipes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="0,0,8,6" Padding="12,6"
                                                    Command="{Binding DataContext.ApplyRecipeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A recipe just fills the settings below — afterwards every value can be changed by hand."/>
                            </StackPanel>
                        </GroupBox>

                        <Border Background="#FFF4E5" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="4"
                                Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#8A5300"/>
                        </Border>

                        <GroupBox Header="Low cut / high cut (fan hum, rumble, hiss)">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Low cut (high-pass)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding HighPassOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding HighPassHz}" Height="28"
                                                  ToolTip="Cuts everything below this frequency. 80-150 Hz removes fan rumble and desk thumps without touching the voice."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="High cut (low-pass)" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding LowPassOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding LowPassHz}" Height="28"
                                                  ToolTip="Cuts the top end. 8-12 kHz removes hiss but makes the voice duller."/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Rumble of a fan or of a desk lives under 150 Hz, the voice starts around 200 Hz: the low cut removes the rumble and leaves the voice alone. These cuts run before the denoise."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <CheckBox Content="Spectral denoise (fft) — constant background: fan, noise, hiss"
                                          IsChecked="{Binding SpectralEnabled}" FontWeight="SemiBold"/>
                            </GroupBox.Header>
                            <StackPanel IsEnabled="{Binding SpectralEnabled}">
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Removes the constant part of the spectrum: the noise floor of the room, fan, hiss. 'Noise floor' must be close to the real level of the noise in the pauses, otherwise nothing is removed or the voice is damaged."/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Measure noise floor from the file" Command="{Binding MeasureNoiseFloorCommand}"
                                            IsEnabled="{Binding CanRun}" Padding="12,4"/>
                                </StackPanel>

                                <TextBlock Text="Noise floor (dB)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="-80" Maximum="-20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NoiseFloorDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NoiseFloorDb, StringFormat={}{0:0} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Rough guide: -70 = quiet room, -55 = fan across the room, -40 = loud fan or street outside the window."/>

                                <TextBlock Text="Reduction (dB)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="1" Maximum="40"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ReductionDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ReductionDb, StringFormat={}{0:0.#} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="How much of the noise to remove. 10-16 dB is usually enough; above 25 dB the voice starts to sound metallic and the noise turns into bubbling."/>

                                <TextBlock Text="Residual floor (dB) — limit of the cleaning" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="-80" Maximum="-20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ResidualFloorDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ResidualFloorDb, StringFormat={}{0:0} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Below this level the filter does not go. The ffmpeg default is -38 dB: with it the noise stays audible. -60 … -70 cleans deeper but may add artefacts."/>

                                <CheckBox Content="Track noise over time (tn)" Margin="0,10,0,0" IsChecked="{Binding TrackNoise}"/>
                                <CheckBox Content="Track the residual after subtraction (tr)" Margin="0,4,0,0" IsChecked="{Binding TrackResidual}"/>
                                <TextBlock Text="Noise type" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding NoiseTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding NoiseType}" Width="160" Height="28" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <CheckBox Content="Speech denoise, neural net (arnndn) — best result for a voice over noise"
                                          IsChecked="{Binding RnnEnabled}" FontWeight="SemiBold"/>
                            </GroupBox.Header>
                            <StackPanel IsEnabled="{Binding RnnEnabled}">
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A small recurrent network separates speech from any other sound; it beats the spectrum cuts on a voice. Needs a model file — one is shipped with the app."/>
                                <TextBlock Text="Model file (.rnnn)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding RnnModel, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseModelCommand}"
                                            Margin="8,0,0,0" Padding="12,4"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A path without a drive letter is taken from the application folder, e.g. models/rnnoise/bd.rnnn."/>

                                <TextBlock Text="Mix (1 = only the model, 0 = input unchanged)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="0" Maximum="1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding RnnMix}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RnnMix, StringFormat={}{0:0.00}}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Values below 1 mix the cleaned signal back with the original: useful when the model makes the voice sound dry."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <CheckBox Content="Noise gate — cut the noise in the pauses"
                                          IsChecked="{Binding GateEnabled}" FontWeight="SemiBold"/>
                            </GroupBox.Header>
                            <StackPanel IsEnabled="{Binding GateEnabled}">
                                <TextBlock Text="Threshold (dB) — everything below it is pushed down" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="-80" Maximum="-5"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GateThresholdDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GateThresholdDb, StringFormat={}{0:0} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Ratio" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="1" Maximum="20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GateRatio}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GateRatio, StringFormat={}{0:0.#}:1}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Attenuation below the threshold (dB)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="-80" Maximum="0"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GateRangeDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GateRangeDb, StringFormat={}{0:0} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="The gate works on the pauses: set the threshold a few dB below the quietest word. Too high and the voice is chopped into pieces, too low and the noise stays."/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Эквалайзер и уровень ===================== -->
            <TabItem Header="Equalizer and level">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">

                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Enable equalizer" IsChecked="{Binding EqEnabled}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="24,0,6,0"/>
                            <ComboBox ItemsSource="{Binding EqPresetNames}" SelectedItem="{Binding EqPreset}" Width="170" Height="28"/>
                            <Button Content="Reset to flat" Command="{Binding ResetEqualizerCommand}" Margin="12,0,0,0" Padding="12,4"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Bands}" Margin="0,18,0,0" IsEnabled="{Binding EqEnabled}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="62" Margin="2,0">
                                        <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.#;-0.#;0} dB}" HorizontalAlignment="Center" FontSize="11"/>
                                        <Slider Orientation="Vertical" Height="230" Minimum="-12" Maximum="12" TickFrequency="1"
                                                TickPlacement="BottomRight" IsSnapToTickEnabled="True" HorizontalAlignment="Center"
                                                Value="{Binding GainDb}" Margin="0,6"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock HorizontalAlignment="Center" Text="Band centre frequency, Hz" Style="{StaticResource Hint}"/>

                        <GroupBox Header="Level" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Gain (dB)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Style="{StaticResource SliderRow}" Minimum="-20" Maximum="20"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GainDb}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding GainDb, StringFormat={}{0:+0.#;-0.#;0} dB}" Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="After processing" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding LevelTargets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Level}" Height="28"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Loudness (loudnorm) evens out the whole file to -16 LUFS — a good default for voice. The peak limiter only guards against overload. Gain is applied before the level stage."/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Прогон ===================== -->
            <TabItem Header="Preview and run">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Preview (a short piece, before the full run)">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Start at, s" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding StartSeconds}" Width="90" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Length, s" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding LimitSeconds}" Width="90" Height="28" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The preview is written to a temporary file. Listen to it, change the settings, render again — then process the whole file."/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Render preview" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanRun}"
                                        Style="{StaticResource ActionButton}"/>
                                <Button Content="Play preview" Command="{Binding PlayPreviewCommand}" IsEnabled="{Binding HasPreview}"
                                        Style="{StaticResource ActionButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="1">
                    <Border Background="#FFF4E5" BorderBrush="#E0A800" BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,0,0,8"
                            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#8A5300"/>
                    </Border>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="Process the whole file" Command="{Binding ProcessCommand}" IsEnabled="{Binding CanRun}"
                                Background="#1E7A34" Foreground="White" FontWeight="Bold" Style="{StaticResource ActionButton}"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}"
                                Style="{StaticResource ActionButton}"/>
                        <Button Content="Play result" Command="{Binding PlayOutputCommand}" IsEnabled="{Binding HasOutput}"
                                Style="{StaticResource ActionButton}"/>
                        <Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}"
                                Style="{StaticResource ActionButton}"/>
                        <CheckBox Content="Analyse result" VerticalAlignment="Center" Margin="8,0,16,6" IsChecked="{Binding AutoAnalyze}"
                                  ToolTip="After the run, compare the noise floor, RMS and peak of the input and the result."/>
                        <Button Content="Analyse result now" Command="{Binding AnalyzeResultCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Reset settings" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <ProgressBar Height="18" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" FontSize="12"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding ResultText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>

                        <GroupBox Grid.Row="1" Header="Before / after">
                            <TextBlock Text="{Binding AnalysisText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="ffmpeg command">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding CommandText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="11" MaxHeight="70" VerticalScrollBarVisibility="Auto"/>
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyCommandCommand}" Margin="8,0,0,0"
                                        Padding="12,4" VerticalAlignment="Top"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="ffmpeg log (last lines)">
                            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                        </GroupBox>
                    </Grid>

                </Grid>
            </TabItem>

        </TabControl>

        <TextBlock Grid.Row="1" Margin="2,8,2,0" Style="{StaticResource Hint}"
                   Text="The window works on finished files: it never touches the recording itself, it always writes a new file. Video is copied, only the audio is re-encoded, so processing is fast."/>
    </Grid>
</Window>
